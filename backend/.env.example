# --- Database ---
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=apimonitor

# --- Auth ---
# NEVER commit a real secret. Generate one, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Monitoring engine ---
# Base URL the engine uses for monitors (demo monitors point at BACKEND_PUBLIC_URL/demo/*)
BACKEND_PUBLIC_URL=http://localhost:8000
# Set to "false" in production to block checks against loopback/private IPs.
MONITOR_ALLOW_LOOPBACK=true
# Prune check results older than this many days.
RESULTS_RETENTION_DAYS=30
# Escalate open incidents from high -> critical after this many minutes of downtime.
INCIDENT_ESCALATION_MINUTES=15

# --- Notifications ---
# Optional SMTP settings for email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Misc ---
LOG_LEVEL=INFO
