# API Monitoring & Incident Tracking Platform — environment template
# Copy to .env and fill in real values. NEVER commit a filled .env.

# ── Backend ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
# Atlas example: MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=api_monitoring

# Required: generate with `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Email alerts (SMTP). Leave unset to disable email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Monitoring defaults
MONITOR_DEFAULT_INTERVAL=300
MONITOR_DEFAULT_TIMEOUT=10
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2

# Allow monitors/webhooks to target localhost & loopback ranges.
# true = convenient for local demo. SET TO false IN PRODUCTION.
MONITOR_ALLOW_LOOPBACK=true

# Public URL of the API (used in email/webhook payloads)
BACKEND_PUBLIC_URL=http://localhost:8000

# Data lifecycle / health thresholds
RESULTS_RETENTION_DAYS=30
DEGRADED_LATENCY_MS=1000
# Escalate open incidents from high -> critical after this many minutes of downtime.
INCIDENT_ESCALATION_MINUTES=15

# App environment: development | test | production.
# production = fail-fast guards (refuses default/weak JWT_SECRET) + scheduler protections.
ENVIRONMENT=development

# ── Frontend (Vite: only VITE_ prefixed vars are exposed to the SPA) ──────
VITE_API_URL=http://localhost:8000
